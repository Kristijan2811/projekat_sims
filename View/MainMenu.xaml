<Window x:Class="BookingApp.View.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glavni meni" Height="200" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
	<StackPanel Margin="20">
		<Button Content="Prikaz svih hotela po zvezdicama"
                Height="40" Margin="0,0,0,10"
                Click="ShowHotelsButton_Click"/>

		<Button Content="Pretraga hotela"
                Height="40"
                Click="SearchHotelsButton_Click"/>
	</StackPanel>
</Window>
