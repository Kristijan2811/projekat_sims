<Window x:Class="BookingApp.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prijava" Height="230" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Email -->
        <TextBlock Text="Email:" Grid.Row="0" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="EmailTextBox"
                 Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Lozinka -->
        <TextBlock Text="Lozinka:" Grid.Row="1" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

        <!-- Dugme Prijava -->
        <Button Content="Prijava"
                Grid.Row="2" Grid.ColumnSpan="2"
                Width="100" Height="30"
                HorizontalAlignment="Center"
                Click="LoginButton_Click"/>
    </Grid>
</Window>
