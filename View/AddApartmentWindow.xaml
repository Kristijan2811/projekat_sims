<Window x:Class="BookingApp.View.AddApartmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unos apartmana" Height="400" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Hotel -->
        <TextBlock Text="Hotel:" Grid.Row="0" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <ComboBox x:Name="HotelComboBox"
                  Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                  ItemsSource="{Binding OwnerHotels}"
                  SelectedItem="{Binding SelectedHotel}"
                  DisplayMemberPath="Name"/>

        <!-- Ime apartmana -->
        <TextBlock Text="Ime apartmana:" Grid.Row="1" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="NameTextBox"
                 Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Opis -->
        <TextBlock Text="Opis:" Grid.Row="2" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Top"/>
        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Broj soba -->
        <TextBlock Text="Broj soba:" Grid.Row="3" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="RoomCountTextBox"
                 Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding RoomCountText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Max broj gostiju -->
        <TextBlock Text="Max broj gostiju:" Grid.Row="4" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="MaxGuestsTextBox"
                 Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding MaxGuestsText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Dugme -->
        <Button Content="Sacuvaj apartman"
                Grid.Row="5" Grid.ColumnSpan="2"
                Width="150" Height="30"
                HorizontalAlignment="Center"
                Click="SaveButton_Click"/>
    </Grid>
</Window>
