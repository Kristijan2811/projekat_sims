<Window x:Class="BookingApp.View.OwnerHotelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moji hoteli (potvrda)" Height="400" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <DockPanel Margin="10">

        <!-- Gornji deo: filter -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <TextBlock Text="Filtriraj:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <ComboBox Width="150"
                      SelectedValue="{Binding SelectedFilter}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="Sve"/>
                <ComboBoxItem Content="Na cekanju"/>
                <ComboBoxItem Content="Prihvaceni"/>
            </ComboBox>
        </StackPanel>

        <!-- Donji deo: dugmad -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Potvrdi"
                    Width="100" Height="30"
                    Margin="0,0,5,0"
                    Click="ApproveButton_Click"/>
            <Button Content="Odbij"
                    Width="100" Height="30"
                    Click="RejectButton_Click"/>
        </StackPanel>

        <!-- Glavni deo: lista hotela -->
        <DataGrid ItemsSource="{Binding Hotels}"
                  SelectedItem="{Binding SelectedHotel}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sifra" Binding="{Binding Code}" />
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Godina izgradnje" Binding="{Binding ConstructionYear}" />
                <DataGridTextColumn Header="Zvezdice" Binding="{Binding Stars}" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
