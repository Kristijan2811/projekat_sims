<Window x:Class="BookingApp.View.OwnerRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registracija vlasnika" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- JMBG -->
        <TextBlock Text="JMBG:" Grid.Row="0" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="JmbgTextBox"
                 Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding Jmbg, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Ime -->
        <TextBlock Text="Ime:" Grid.Row="1" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="FirstNameTextBox"
                 Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Prezime -->
        <TextBlock Text="Prezime:" Grid.Row="2" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="LastNameTextBox"
                 Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Telefon -->
        <TextBlock Text="Telefon:" Grid.Row="3" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="PhoneTextBox"
                 Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Email -->
        <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <TextBox x:Name="EmailTextBox"
                 Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Lozinka -->
        <TextBlock Text="Lozinka:" Grid.Row="5" Grid.Column="0"
                   Margin="0,0,10,10" VerticalAlignment="Center"/>
        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"/>

        <!-- Dugme -->
        <Button Content="Registruj vlasnika"
                Grid.Row="6" Grid.ColumnSpan="2"
                Width="150" Height="30"
                HorizontalAlignment="Center"
                Click="RegisterButton_Click"/>
    </Grid>
</Window>
